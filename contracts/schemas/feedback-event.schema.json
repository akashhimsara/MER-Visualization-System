{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feedback Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "session_id",
    "sequence",
    "audio_time_ms",
    "feedback_id",
    "preset_id",
    "feedback"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "event_type": {
      "const": "feedback.event"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "audio_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "feedback_id": {
      "type": "string",
      "minLength": 1
    },
    "preset_id": {
      "type": "string",
      "minLength": 1
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "like",
            "dislike",
            "rating",
            "preset_select",
            "preset_skip",
            "view_duration"
          ]
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "rating"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "rating"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "view_duration"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "duration_ms"
            ]
          }
        }
      ]
    }
  }
}