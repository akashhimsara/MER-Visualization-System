{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MER Tier 2 Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "session_id",
    "sequence",
    "audio_time_ms",
    "tempo_bpm",
    "tempo_confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "event_type": {
      "const": "mer.tier2"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "audio_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "tempo_bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "tempo_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}