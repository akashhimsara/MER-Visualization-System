{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MER Tier 3 Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "session_id",
    "sequence",
    "audio_time_ms",
    "emotion"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "event_type": {
      "const": "mer.tier3"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "audio_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valence",
        "arousal",
        "confidence"
      ],
      "properties": {
        "valence": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "arousal": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}